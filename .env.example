# Copiá este archivo como .env.local (para tu compu) y cargá las mismas variables en Vercel.
# Las que dicen (opcional) se pueden dejar vacías.

# --- WhatsApp Cloud API (Meta) ---
# Token permanente de un "usuario del sistema" (ver README, paso 5).
WHATSAPP_TOKEN=
# Clave que inventás vos; la misma que ponés en Meta al configurar el webhook.
WHATSAPP_VERIFY_TOKEN=inventa-una-clave-larga
# "Clave secreta de la app" (Meta > tu app > Configuración > Básica). Sirve para validar la firma.
WHATSAPP_APP_SECRET=

# Identificador del número de cada local (Meta > WhatsApp > Configuración de la API > "Identificador del número de teléfono").
WHATSAPP_PHONE_NUMBER_ID_CENTRO=
WHATSAPP_PHONE_NUMBER_ID_PERICO=
# (opcional) Si tenés un solo número, podés usar esta en lugar de la de CENTRO.
WHATSAPP_PHONE_NUMBER_ID=

# --- Avisos al dueño ---
# Tu celular personal, con código de país y sin el 0 ni el 15. Ej: 5493884123456
OWNER_PHONE=
# (opcional) Un celular distinto por local. Si están vacías se usa OWNER_PHONE.
OWNER_PHONE_CENTRO=
OWNER_PHONE_PERICO=
# (opcional, recomendado) Nombre de la plantilla aprobada para avisos (ver README, paso 8).
OWNER_ALERT_TEMPLATE=aviso_derivacion
OWNER_ALERT_TEMPLATE_LANG=es_AR
# (opcional) "si" = mientras una conversación está derivada, te reenvía al celular lo que escribe el cliente
# y le podés contestar con:  r 5493884123456 tu mensaje
REENVIAR_AL_DUENIO=no

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=
# (opcional) Modelo. Por defecto claude-haiku-5-5 (rápido y barato).
CLAUDE_MODEL=claude-haiku-5-5

# --- Base de datos (Upstash Redis / Vercel KV) ---
# Si conectás Upstash desde Vercel se cargan solas (pueden llamarse KV_REST_API_URL / KV_REST_API_TOKEN; las dos sirven).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Otros (opcionales) ---
# Imagen de la carta que se manda junto con el texto cuando piden la carta.
# Después de publicar en Vercel: https://TU-APP.vercel.app/carta-seitu.jpeg
CARTA_IMAGEN_URL=
# Clave para usar el simulador en la versión publicada (/simulador). Vacía = simulador apagado en Vercel.
SIMULADOR_CLAVE=
# Versión de la API de Meta.
WHATSAPP_GRAPH_VERSION=v23.0
